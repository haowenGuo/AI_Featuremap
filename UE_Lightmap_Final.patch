 #if USE_NEURAL_LIGHTMAP
-    /** HPRC Example Start */
+    /* HPRC Example Start 
 	float4 Test[2];
 	Test[0] = Texture2DSample( LightmapResourceCluster.NeuralLightMapTexture, LightmapResourceCluster.NeuralLightMapSampler, LightmapUV0);
 	float4 NeuralLightMapParameters[1024] = GetLightmapData(LightmapDataIndex).NeuralLightMapParameters;
