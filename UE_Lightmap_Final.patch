 		LightmapUVType ShadowMapCoordinate;
@@ -347,11 +429,11 @@ half4 GetPrecomputedShadowMasks(VTPageTableResult LightmapVTPageTableResult, FVe
 
 		// Fetch the 4 channels of distance field data
 		half4 DistanceField;
-#if LIGHTMAP_VT_ENABLED
